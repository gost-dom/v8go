+// GCC does not provide the clang builtin __has_warning. Without a fallback,
+// the clang-only diagnostic guards below expand to `0(...)` under GCC, which
+// is a preprocessor syntax error ("missing binary operator before (").
+#ifndef __has_warning
+#define __has_warning(x) 0
+#endif
+
